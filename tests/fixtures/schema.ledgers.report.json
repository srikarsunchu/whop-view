{
  "options": {
    "type": "object",
    "properties": {
      "account_id": {
        "description": "The owning account ID (a biz_ identifier), or `global` for a platform-wide report across all ledger accounts (requires internal admin access).",
        "type": "string"
      },
      "report_type": {
        "type": "string",
        "enum": [
          "balance_summary",
          "income_statement",
          "balance_activity"
        ],
        "description": "The type of financial report to generate."
      },
      "currency": {
        "description": "Filter rows to this currency, for example `usd`. Defaults to `usd` unless `in_currency` is provided.",
        "type": "string"
      },
      "in_currency": {
        "description": "Aggregate all activity into this display currency via FX conversion.",
        "type": "string"
      },
      "from": {
        "description": "Start of the report window as an ISO 8601 timestamp. Required for platform-wide (global) reports.",
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "to": {
        "description": "Exclusive end of the report window as an ISO 8601 timestamp. Required for platform-wide (global) reports.",
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "group_by": {
        "description": "Grouping granularity for report rows. Hourly grouping is supported for account-level balance activity reports only; hourly periods are timestamps in the requested timezone.",
        "type": "string",
        "enum": [
          "hour",
          "day",
          "week",
          "month"
        ]
      },
      "timezone": {
        "description": "IANA timezone (for example `America/New_York`) used to bucket report periods. Defaults to UTC. `from` and `to` remain exact instants.",
        "type": "string"
      },
      "line_types": {
        "description": "Account-level balance activity only: ledger line categories to include.",
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "account_settlement",
            "ad_budget_release",
            "ad_campaign_budget",
            "ad_publisher_payout",
            "ad_publisher_payout_received",
            "ad_spend_charge",
            "affiliate_fee",
            "airdrop",
            "airdrop_link_created",
            "airdrop_link_redeemed",
            "airdrop_link_returned",
            "airdrop_reversal",
            "application_fee",
            "application_fee_payout",
            "balance_reservation",
            "balance_reservation_reversal",
            "bank_transfer",
            "billing_percentage_fee",
            "buyer_fee",
            "card_interchange",
            "card_load_deposit",
            "card_load_transfer",
            "card_spend_authorization",
            "card_spend_authorization_void",
            "card_spend_refund",
            "card_unload_deposit",
            "card_unload_transfer",
            "cashback",
            "cashback_funding",
            "company_referral",
            "connected_account_negative_balance",
            "cross_border_percentage_fee",
            "currency_conversion_incoming",
            "currency_conversion_outgoing",
            "dispute_alert_fee",
