{
  "name": "whop-view",
  "version": "0.0.1",
  "description": "wv: a human view layer for the Whop CLI. Unofficial design prototype, not affiliated with Whop.",
  "author": "srikarsunchu",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "bin": { "wv": "./dist/bin.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
