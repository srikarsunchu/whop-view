    "fixtures": "node --experimental-strip-types scripts/fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.14.0"
}
